generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Rol {
  ADMIN
  ASESOR
}

// ───────────────────────── Autenticación (Better Auth) ─────────────────────────
// Better Auth localiza los modelos por NOMBRE (User, Session...), no por tabla.
// Los ids son texto porque Better Auth genera sus propios ids.

model User {
  id            String   @id
  name          String
  email         String   @unique
  emailVerified Boolean  @default(false) @map("email_verified")
  image         String?
  role          Rol      @default(ASESOR)
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  sessions            Session[]
  accounts            Account[]
  asesor              Asesor?
  invitacionesCreadas Invitacion[] @relation("InvitacionCreadaPor")
  invitacionUsada     Invitacion?  @relation("InvitacionUsadaPor")

  @@map("users")
}

model Session {
  id        String   @id
  token     String   @unique
  expiresAt DateTime @map("expires_at") @db.Timestamptz(3)
  ipAddress String?  @map("ip_address")
  userAgent String?  @map("user_agent")
  userId    String   @map("user_id")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model Account {
  id                    String    @id
  accountId             String    @map("account_id")
  providerId            String    @map("provider_id")
  userId                String    @map("user_id")
  accessToken           String?   @map("access_token")
  refreshToken          String?   @map("refresh_token")
  idToken               String?   @map("id_token")
  accessTokenExpiresAt  DateTime? @map("access_token_expires_at") @db.Timestamptz(3)
  refreshTokenExpiresAt DateTime? @map("refresh_token_expires_at") @db.Timestamptz(3)
  scope                 String?
  password              String? // hash scrypt; nunca la contraseña en claro
  createdAt             DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt             DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([providerId, accountId])
  @@index([userId])
  @@map("accounts")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime @map("expires_at") @db.Timestamptz(3)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([identifier])
  @@map("verifications")
}

// Contadores del rate limiting de Better Auth (almacenamiento en BD).
model RateLimit {
  id          String @id
  key         String @unique
  count       Int
  lastRequest BigInt @map("last_request")

  @@map("rate_limits")
}

// ───────────────────────────── Dominio ─────────────────────────────

model Asesor {
  id            String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  slug          String   @unique @db.VarChar(60)
  userId        String   @unique @map("user_id")
  nombre        String   @db.VarChar(120)
  telefono      String   @db.Char(12) // formato wa.me: 52 + 10 dígitos
  emailContacto String?  @map("email_contacto") @db.VarChar(254)
  fotoUrl       String?  @map("foto_url")
  activo        Boolean  @default(true)
  creadoEn      DateTime @default(now()) @map("creado_en") @db.Timestamptz(3)
  actualizadoEn DateTime @updatedAt @map("actualizado_en") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@map("asesores")
}

model Invitacion {
  id          String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  tokenHash   String    @unique @map("token_hash") @db.Char(64) // SHA-256 hex del token
  etiqueta    String?   @db.VarChar(80) // nota del admin: "para Gaby"
  creadaPorId String    @map("creada_por_id")
  usadaPorId  String?   @unique @map("usada_por_id")
  creadaEn    DateTime  @default(now()) @map("creada_en") @db.Timestamptz(3)
  expiraEn    DateTime  @map("expira_en") @db.Timestamptz(3)
  usadaEn     DateTime? @map("usada_en") @db.Timestamptz(3)

  creadaPor User  @relation("InvitacionCreadaPor", fields: [creadaPorId], references: [id], onDelete: Restrict)
  usadaPor  User? @relation("InvitacionUsadaPor", fields: [usadaPorId], references: [id], onDelete: Restrict)

  @@index([creadaPorId])
  @@index([expiraEn])
  @@map("invitaciones")
}