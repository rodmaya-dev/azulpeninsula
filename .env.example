# ── Sitio público ──────────────────────────────────────────
# Sin dominio propio todavía: el sitio vive en Vercel. Cuando haya
# dominio, esta es la única línea que cambia (+ redirect 301 en Vercel).
NEXT_PUBLIC_SITE_URL="https://azulpeninsula.vercel.app"
NEXT_PUBLIC_WHATSAPP_NUMBER="52XXXXXXXXXX"

# ── Resend (formulario de Contacto) ────────────────────────
# Consigue tu key en https://resend.com/api-keys (plan gratuito: 3,000
# correos/mes, más que suficiente para un formulario de contacto).
RESEND_API_KEY=""
# Sin dominio propio verificado en Resend, deja este valor tal cual —
# es la única dirección remitente que Resend permite sin verificación.
RESEND_FROM="Azul Península <onboarding@resend.dev>"

# ── Base de datos (Neon + Prisma) ──────────────────────────
# DATABASE_URL: conexión con pooler (host con "-pooler"), la usa la app.
# DIRECT_URL: conexión directa, la usa la CLI de Prisma para migraciones.
DATABASE_URL=""
DIRECT_URL=""

# ── Autenticación (Better Auth) ────────────────────────────
# Secreto de 32+ bytes: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
BETTER_AUTH_SECRET=""
# URL base del sitio: http://localhost:3000 en local, la URL pública en producción.
BETTER_AUTH_URL="http://localhost:3000"